# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 절대 커밋/공유하지 마세요.
# 모두 선택 사항입니다. LLM을 연결하지 않으면 규칙 기반으로만 동작합니다.

# OpenAI 호환 LLM 서버 (Ollama, Groq, Gemini 호환 엔드포인트 등)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 임베딩 검색(선택). 비워 두면 키워드(BM25) 검색만 사용
EMBED_MODEL=

# 매뉴얼 PDF 위치 (기본 data/학교민원처리매뉴얼.pdf)
MANUAL_PDF=

# 민원 DB. 비워 두면 SQLite 파일(data/complaints.sqlite)을 쓴다.
# 외부 SQL DB 예: postgresql+psycopg://사용자:비밀번호@주소:5432/DB이름   (해당 드라이버 설치 필요)
# 주의: Upstash는 Redis 계열이라 이 주소로 연결되지 않는다(CLAUDE.md의 DB 항목 참고).
DATABASE_URL=

# 과거 이력 판단 기준 (기본 180일 / 24시간)
HISTORY_WINDOW_DAYS=
RECONTACT_HOURS=

# 악성 반복 판단: 유사도 임계값(기본 0.8)과 LLM에게 유사도를 묻는 횟수(기본 3)
REPEAT_SIM_THRESHOLD=
REPEAT_SIM_SAMPLES=

# 학사일정(나이스 교육정보 개방 포털). 셋 다 있어야 동작
NEIS_API_KEY=
NEIS_OFFICE_CODE=
NEIS_SCHOOL_CODE=

# 이첩 보고서
SCHOOL_NAME=
TRANSFER_TEMPLATE=
